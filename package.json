{
  "name": "hivemind-js",
  "version": "0.2.0",
  "description": "HiveMind protocol client for the browser and Node.js — native Web Crypto + @noble (ChaCha20-Poly1305, argon2id) for full v3 Noise cipher parity",
  "license": "Apache-2.0",
  "author": "JarbasAi <jarbasai@mailfence.com>",
  "homepage": "https://github.com/JarbasHiveMind/HiveMind-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JarbasHiveMind/HiveMind-js.git"
  },
  "bugs": {
    "url": "https://github.com/JarbasHiveMind/HiveMind-js/issues"
  },
  "main": "static/js/hivemind.js",
  "module": "static/js/hivemind.js",
  "exports": {
    ".": {
      "require": "./static/js/hivemind.js",
      "import": "./static/js/hivemind.js",
      "default": "./static/js/hivemind.js"
    }
  },
  "browser": "static/js/hivemind.js",
  "files": [
    "static/js/hivemind.js",
    "docs",
    "readme.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:e2e": "python3 test/e2e/loopback_hub.py"
  },
  "devDependencies": {
    "ws": "^8.18.0"
  },
  "keywords": [
    "hivemind",
    "mycroft",
    "ovos",
    "openvoiceos",
    "voice-assistant",
    "websocket",
    "protocol-v1",
    "protocol-v3",
    "noise-protocol",
    "x25519",
    "chacha20-poly1305",
    "aes-gcm",
    "argon2id",
    "web-crypto"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0"
  }
}
